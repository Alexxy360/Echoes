{
  "name": "echoes-development-probe",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "PROBE_ENABLED": "0",
    "PROBE_LOCAL_CHECK_ONLY": "0",
    "CLOUDKIT_CONTAINER": "iCloud.mpvEcho.Echo",
    "CLOUDKIT_ENVIRONMENT": "development",
    "PROBE_RUN_ID": "",
    "PROBE_EXPIRES_AT": ""
  },
  "durable_objects": {
    "bindings": [{ "name": "DEVELOPMENT_PROBE", "class_name": "DevelopmentProbe" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DevelopmentProbe"] }]
}
