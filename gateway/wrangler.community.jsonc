{
  "name": "echoes-community-development",
  "main": "src/community-worker.mjs",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "GATEWAY_ENABLED": "0",
    "GATEWAY_ENVIRONMENT": "development",
    "GATEWAY_EXPIRES_AT": "",
    "ACCOUNT_DELETION_ENABLED": "0",
    "PUBLIC_RECORDS_ENABLED": "0",
    "PUBLIC_RETENTION_ENABLED": "0",
    "COMMUNITY_ENABLED": "0",
    "AVATAR_READ_ENABLED": "0",
    "AVATAR_OWNER_PREVIEW_ENABLED": "0",
    "AVATAR_DOWNLOAD_HOSTS_JSON": "[]",
    "AVATAR_UPLOAD_ENABLED": "0",
    "AVATAR_REVIEW_ENABLED": "0",
    "AVATAR_REVIEWER_IDS_JSON": "[]",
    "AVATAR_UPLOAD_HOSTS_JSON": "[]",
    "COMMUNITY_SUPPORT_URL": "",
    "COMMUNITY_BLOCKED_PHRASES_JSON": "[]",
    "CLOUDKIT_CONTAINER": "iCloud.mpvEcho.Echo",
    "CLOUDKIT_ENVIRONMENT": "development",
    "REFRESH_ACTIVE_KEY_ID": "v1",
    "RENEWAL_ACTIVE_KEY_ID": "v1"
  },
  "durable_objects": {
    "bindings": [{ "name": "COMMUNITY_AUTHORITY", "class_name": "CommunityAuthority" }]
  },
  "migrations": [{ "tag": "community-v1", "new_sqlite_classes": ["CommunityAuthority"] }]
}
